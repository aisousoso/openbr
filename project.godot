; Engine configuration file.
; OpenBR — open-source battle royale prototype (MIT).
; Godot 4.4+

config_version=5

[application]

config/name="OpenBR"
config/description="Open-source battle royale prototype. Server-authoritative. MIT licensed."
config/icon="res://assets/icon.svg"
run/main_scene="res://client/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[autoload]

GameInput="*res://scripts/game_input.gd"
Net="*res://scripts/net.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=30

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
